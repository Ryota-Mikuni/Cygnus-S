// Generated by generate_cygnus_zmk_and_visuals.js
// Cygnus-S official 43-position keymap for config/Cygnus.keymap
// Source: cygnus_cornix_like_keymap.json
// Note: verify the physical matrix order against the delivered Cygnus firmware before flashing.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt { tapping-term-ms = <200>; };

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <0>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp Q      &kp L     &kp U     &kp COMMA    &kp DOT                                                   &kp F      &kp W  &kp R  &kp Y  &kp P
&kp E      &kp I     &kp A     &kp O        &kp MINUS         &kp C_MUTE       &kp LEFT_PARENTHESIS   &kp K      &kp T  &kp N  &kp S  &kp H
&kp J      &kp X     &kp C     &kp V        &kp QMARK         &kp TAB          &kp RIGHT_PARENTHESIS  &kp G      &kp D  &kp M  &kp Z  &kp B
&kp LCTRL  &kp LALT  &kp LGUI  &lt 3 LANG2  &mt LSHIFT SPACE  &lt 1 ENTER      &lt 2 BSPC             &kp LANG1                       &kp ESCAPE
            >;
        };

        num_layer {
            display-name = "Num";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp RBKT   &kp HASH  &kp N7    &kp N8       &kp N9                                        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &kp KP_MINUS
&kp SEMI   &kp SQT   &kp N4    &kp N5       &kp N6            &kp C_MUTE      &kp SQT     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &kp KP_DIVIDE
&kp LBKT   &kp N0    &kp N1    &kp N2       &kp N3            &none           &kp N0      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp SLASH        &kp KP_DOT
&kp LCTRL  &kp LALT  &kp LGUI  &lt 3 LANG2  &mt LSHIFT SPACE  &none           &lt 2 BSPC  &kp LANG1                                                           &kp ESCAPE
            >;
        };

        nav_layer {
            display-name = "Nav";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp HOME   &kp PG_UP       &kp UP_ARROW    &kp PG_DN        &kp END                                   &kp HOME   &kp PG_UP       &kp UP_ARROW    &kp PG_DN        &kp END
&none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none             &kp C_MUTE       &none  &none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&kp LG(Z)  &kp LG(X)       &kp LG(C)       &kp LG(V)        &kp LS(LG(Z))     &none            &none  &kp LG(Z)  &kp LG(X)       &kp LG(C)       &kp LG(V)        &kp LS(LG(Z))
&kp LCTRL  &kp LALT        &kp LGUI        &lt 3 LANG2      &mt LSHIFT SPACE  &lt 1 ENTER      &none  &kp LANG1                                                   &kp ESCAPE
            >;
        };

        function_layer {
            display-name = "Fn";
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4  &kp F5                                         &kp F1     &kp F2   &kp F3  &kp F4  &kp F5
&kp F6     &kp F7    &kp F8    &kp F9  &kp F10           &kp C_MUTE       &none       &kp F6     &kp F7   &kp F8  &kp F9  &kp F10
&kp F11    &kp F12   &none     &none   &none             &none            &none       &kp F11    &kp F12  &none   &none   &none
&kp LCTRL  &kp LALT  &kp LGUI  &none   &mt LSHIFT SPACE  &lt 1 ENTER      &lt 2 BSPC  &kp LANG1                           &kp ESCAPE
            >;
        };

        automouse_layer {
            display-name = "AutoMouse";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &trans  &trans  &trans  &trans                            &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &kp C_MUTE      &mkp MB5  &mkp MB4  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &kp ENTER       &kp BSPC  &mo 5                                   &trans
            >;
        };

        scroll_layer {
            display-name = "Scroll";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &kp C_MUTE      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                          &trans
            >;
        };
    };
};
