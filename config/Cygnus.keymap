            gesture_back_copy_layer { // Layer 6: G6 BackCopy
                display-name = "G6 BackCopy";
                sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
                bindings = <
                    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans  &trans  &trans  &trans  &trans  &kp C_MUTE  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                >;
            };

            gesture_forward_tabs_layer { // Layer 7: G7 ForwardTabs
                display-name = "G7 ForwardTabs";
                sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
                bindings = <
