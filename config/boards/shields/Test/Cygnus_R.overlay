#include "Cygnus.dtsi"
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/ {
    g6_back_copy: g6_back_copy {
        compatible = "cygnus,input-processor-gesture";
        #input-processor-cells = <0>;
        tick = <40>;
        wait-ms = <250>;
        tap-ms = <20>;
        /* right, left, up, down */
        bindings = <&mkp MB5>, <&mkp MB4>, <&kp LG(C)>, <&kp LG(V)>;
    };

    g7_forward_tabs: g7_forward_tabs {
        compatible = "cygnus,input-processor-gesture";
        #input-processor-cells = <0>;
        tick = <40>;
        wait-ms = <250>;
        tap-ms = <20>;
        /* right, left, up, down */
        bindings = <&kp LC(TAB)>, <&kp LS(LC(TAB))>, <&kp LG(T)>, <&kp LG(W)>;
    };

    g8_pan_scroll: g8_pan_scroll {
        compatible = "cygnus,input-processor-gesture";
        #input-processor-cells = <0>;
        tick = <40>;
        wait-ms = <120>;
        tap-ms = <20>;
        /* right, left, up, down */
        bindings = <&kp RIGHT_ARROW>, <&kp LEFT_ARROW>, <&kp UP_ARROW>, <&kp DOWN_ARROW>;
    };

    g9_system: g9_system {
        compatible = "cygnus,input-processor-gesture";
        #input-processor-cells = <0>;
        tick = <40>;
        wait-ms = <300>;
        tap-ms = <20>;
        /* right, left, up, down */
        bindings = <&kp LC(RIGHT_ARROW)>, <&kp LC(LEFT_ARROW)>, <&kp LC(UP_ARROW)>, <&kp LC(DOWN_ARROW)>;
    };

    g10_window: g10_window {
        compatible = "cygnus,input-processor-gesture";
        #input-processor-cells = <0>;
        tick = <40>;
        wait-ms = <300>;
        tap-ms = <20>;
        /* right, left, up, down */
        bindings = <&kp LG(RIGHT_ARROW)>, <&kp LG(LEFT_ARROW)>, <&kp LC(LG(F))>, <&kp LG(M)>;
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        gesture_back_copy {
            layers = <6>;
            input-processors = <&g6_back_copy>;
        };

        gesture_forward_tabs {
            layers = <7>;
            input-processors = <&g7_forward_tabs>;
        };

        gesture_pan_scroll {
            layers = <8>;
            input-processors = <&g8_pan_scroll>;
        };

        gesture_system {
            layers = <9>;
            input-processors = <&g9_system>;
        };

        gesture_window {
            layers = <10>;
            input-processors = <&g10_window>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        automouse-layer = <4>;
        scroll-layers = <5>;
    };
};
